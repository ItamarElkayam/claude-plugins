{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "topic.schema.json",
  "title": "Topic-level synthesis across papers",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic_id", "name", "summary", "papers", "generated_by"],
  "definitions": {
    "grounded_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 15},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "paper_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_strength": {"type": ["string", "null"], "enum": ["strong", "moderate", "weak", "single_study", "contested", null]},
        "note": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "topic_id": {"type": "string", "pattern": "^t-[a-z0-9-]+$"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "parent_topic_id": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 40, "description": "Agent-generated synthesis, explicitly labelled as synthesis in rendered output."},
    "papers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "key_concepts": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"type": "string"}},
    "datasets_and_benchmarks": {"type": "array", "items": {"type": "string"}},
    "agreements": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "qualified_agreements": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "genuine_disagreements": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "apparent_disagreements_explained": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "chronology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "development", "paper_ids"],
        "properties": {
          "year": {"type": ["integer", "string", "null"]},
          "development": {"type": "string"},
          "paper_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "comparison_matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paper_id", "cells"],
            "properties": {
              "paper_id": {"type": "string"},
              "cells": {"type": "array", "items": {"type": ["string", "number", "null"]}},
              "claim_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "common_limitations": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "understudied_conditions": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/definitions/grounded_point"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "prompt", "prompt_version", "generated_at"],
      "properties": {
        "model_id": {"type": "string"},
        "prompt": {"type": "string"},
        "prompt_version": {"type": "string"},
        "generated_at": {"type": "string"},
        "reviewed_by_human": {"type": "boolean"}
      }
    }
  }
}
